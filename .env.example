# Copy to .env for local runs: npm start loads it.
# In prod these come from the ConfigMap in helm-charts-wrappers.
POD_SELECTOR=app.kubernetes.io/name=kube-dino
DATA_FILE=./data/games.json

# Only outside the cluster: run `kubectl proxy` first.
NAMESPACE=kube-dino-prod
KUBE_API_URL=http://127.0.0.1:8001
